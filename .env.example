DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
ENCRYPTION_KEY="replace-with-at-least-32-random-characters-required-in-production"
SESSION_SECRET="replace-with-at-least-32-random-characters-required-in-production"
APP_URL="http://localhost:3000"
PAYMENTS_ENABLED="false"
PAYSTACK_MODE="test"
PAYSTACK_SECRET_KEY=""
NODE_ENV="development"

# Flutterwave payout preparation: sandbox only; transfers remain disabled by default.
FLW_MODE="sandbox"
FLW_TRANSFERS_ENABLED="false"
FLW_SECRET_KEY=""

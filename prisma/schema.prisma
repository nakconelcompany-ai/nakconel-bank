// Nakconel Phase 1 — database schema
// Immutable ledger: never UPDATE/DELETE journal entries; reverse only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  phone        String?
  address      String?
  passwordHash String
  pinHash      String
  kycStatus    KycStatus @default(NONE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  kycSubmissions KycSubmission[]
  auditLogs    AuditLog[]
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("NGN")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  transfersFrom Transfer[] @relation("FromAccount")
  transfersTo   Transfer[] @relation("ToAccount")
}

model Journal {
  id          String   @id @default(uuid())
  description String
  createdAt   DateTime @default(now())
  entries     LedgerEntry[]
}

model LedgerEntry {
  id               String   @id @default(uuid())
  journalId        String
  journal          Journal  @relation(fields: [journalId], references: [id])
  debitAccountId   String
  creditAccountId  String
  amount           Int
  currency         String   @default("NGN")
  reference        String
  status           String   @default("POSTED")
  metadata         Json?
  timestamp        DateTime @default(now())

  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([reference])
}

model Transfer {
  id                 String         @id @default(uuid())
  fromAccountId      String
  fromAccount        Account        @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId        String?
  toAccount          Account?       @relation("ToAccount", fields: [toAccountId], references: [id])
  amount             Int
  fee                Int            @default(0)
  currency           String         @default("NGN")
  status             TransferStatus @default(CREATED)
  beneficiaryName    String
  beneficiaryAccount String
  note               String?
  idempotencyKey     String         @unique
  journalId          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([fromAccountId])
  @@index([status])
}

enum TransferStatus {
  CREATED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  REQUIRES_REVIEW
}

model KycSubmission {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  fullName    String
  dateOfBirth String
  phone       String
  address     String
  bvnEnc      String
  idType      String
  status      KycStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  resourceId String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyRecord {
  key       String   @id
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

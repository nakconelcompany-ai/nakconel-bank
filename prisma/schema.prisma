// Nakconel Phase 1 — database schema (sqlite locally, postgresql in docker)
// Immutable ledger: never UPDATE/DELETE journal entries; reverse only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  phone        String?
  address      String?
  passwordHash String
  pinHash      String
  kycStatus    KycStatus @default(NONE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  kycSubmissions KycSubmission[]
  auditLogs    AuditLog[]
  businessProfiles BusinessProfile[]
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("NGN")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  // Ledger references by account id string — balances computed from journal
  transfersFrom Transfer[] @relation("FromAccount")
  transfersTo   Transfer[] @relation("ToAccount")
}

model Journal {
  id          String   @id @default(uuid())
  description String
  createdAt   DateTime @default(now())
  entries     LedgerEntry[]
}

model LedgerEntry {
  id               String   @id @default(uuid())
  journalId        String
  journal          Journal  @relation(fields: [journalId], references: [id])
  debitAccountId   String
  creditAccountId  String
  amount           Int      // kobo (minor units)
  currency         String   @default("NGN")
  reference        String
  status           String   @default("POSTED") // POSTED | REVERSED
  metadata         Json?
  timestamp        DateTime @default(now())

  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([reference])
}

model Transfer {
  id                 String         @id @default(uuid())
  fromAccountId      String
  fromAccount        Account        @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId        String?
  toAccount          Account?       @relation("ToAccount", fields: [toAccountId], references: [id])
  amount             Int            // kobo
  fee                Int            @default(0)
  currency           String         @default("NGN")
  status             TransferStatus @default(CREATED)
  beneficiaryName    String
  beneficiaryAccount String
  note               String?
  providerRef        String?
  idempotencyKey     String         @unique
  journalId          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([fromAccountId])
  @@index([status])
}

enum TransferStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model KycSubmission {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // BVN | NIN | FACE | ADDRESS
  status    String   @default("PENDING")
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ─── Phase 2: Business ───────────────────────────────────────────────────────

model BusinessProfile {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  businessName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]
  paymentLinks PaymentLink[]
  collections  Collection[]
  expenses     Expense[]
  teamMembers  TeamMember[]

  @@index([userId])
}

model Invoice {
  id            String   @id @default(uuid())
  businessId    String
  business      BusinessProfile @relation(fields: [businessId], references: [id])
  invoiceNumber String
  customerName  String
  customerEmail String?
  amount        Int      // kobo
  currency      String   @default("NGN")
  description   String?
  status        String   @default("UNPAID") // UNPAID | PAID | CANCELLED
  paymentUrl    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

model PaymentLink {
  id           String   @id @default(uuid())
  businessId   String
  business     BusinessProfile @relation(fields: [businessId], references: [id])
  title        String
  amount       Int?     // kobo, null = open amount
  currency     String   @default("NGN")
  url          String
  status       String   @default("ACTIVE")
  collectCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

model Collection {
  id         String   @id @default(uuid())
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id])
  reference  String
  amount     Int      // kobo
  currency   String   @default("NGN")
  source     String   // INVOICE | PAYMENT_LINK | DIRECT
  sourceId   String?
  payerName  String?
  payerEmail String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([createdAt])
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id])
  category    String   // RENT | SALARY | UTILITIES | SUPPLIES | MARKETING | OTHER
  title       String
  amount      Int      // kobo
  currency    String   @default("NGN")
  note        String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([category])
}

model TeamMember {
  id          String   @id @default(uuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id])
  fullName    String
  email       String
  role        String   @default("STAFF") // OWNER | ADMIN | STAFF | ACCOUNTANT
  salaryKobo  Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    TeamPayment[]

  @@index([businessId])
}

model TeamPayment {
  id            String   @id @default(uuid())
  teamMemberId  String
  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id])
  amount        Int      // kobo
  currency      String   @default("NGN")
  period        String?  // e.g. 2026-10
  status        String   @default("PENDING") // PENDING | PAID | FAILED
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([teamMemberId])
}

// ─── Phase 3: International ───────────────────────────────────────────────────

model InternationalTransfer {
  id                   String   @id @default(uuid())
  userId               String
  fromAccountId        String
  corridor             String   // AFRICA | UK | US | GCC | EUROPE
  destinationCountry   String
  destinationCurrency  String
  amountNgnKobo        Int      // amount debited in NGN kobo
  feeKobo              Int
  fxRate               Float    // NGN per 1 unit of dest currency
  amountForeign        Float    // amount recipient gets
  beneficiaryName      String
  beneficiaryAccount   String
  beneficiaryBank      String?
  note                 String?
  status               String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | REQUIRES_REVIEW
  settlementNote       String?
  idempotencyKey       String   @unique
  journalId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([corridor])
  @@index([status])
}
